# ---------------------------------------------------------------------------
# Database
#
# Two URLs, deliberately. DATABASE_URL is the pooled connection the app uses at
# runtime: on Vercel every serverless invocation would otherwise open its own
# Postgres connection and exhaust the server. DIRECT_URL is an unpooled session
# connection used only by `prisma migrate`, which needs advisory locks and DDL
# that a transaction pooler cannot provide.
#
# Supabase: the pooler is port 6543, the direct connection is port 5432.
# Neon / Vercel Postgres expose the same split under different names.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---------------------------------------------------------------------------
# Auth.js
#
# Generate with:  npx auth secret     (or: openssl rand -base64 32)
# On Vercel, set AUTH_SECRET in the project's Environment Variables. AUTH_URL is
# inferred from the deployment, so it is only needed locally or behind a proxy.
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# OAuth provider. Callback URL: {origin}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
