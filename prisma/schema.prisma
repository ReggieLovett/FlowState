// Study & Work Scheduler - data model
//
// Two ideas drive this schema:
//
//   1. Every row a user can reach carries its own `userId`. Nothing is reachable
//      only by traversing a relation, so a query can never "forget" the tenant.
//
//   2. Every user-owned model declares `@@unique([id, userId])`. Prisma's
//      `update` and `delete` require a unique selector, so with `id` alone the
//      owner cannot be part of the WHERE clause and ownership has to be checked
//      in a separate read first. That check is easy to forget and racy. The
//      compound unique gives you `where: { id_userId: { id, userId } }`, which
//      puts ownership into the same statement. A mutation for someone else's row
//      matches nothing and throws, rather than succeeding.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 removed `url` / `directUrl` from the datasource block. Migration
// connection details now live in prisma.config.ts, and the runtime connection is
// supplied to PrismaClient through a driver adapter (see lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js models
//
// Shapes are dictated by @auth/prisma-adapter. The only additions are the
// relations to the domain models and `passwordHash` for credentials sign-in.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Null for OAuth-only accounts. Never selected outside the authorize callback.
  passwordHash String?

  accounts Account[]
  sessions Session[]

  subjects Subject[]
  items    SubjectItem[]
  events   ScheduleEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

/// Commitment types for college students and working professionals.
enum Category {
  LECTURE
  SEMINAR
  LAB_SESSION
  CLIENT_MEETING
  PROJECT_DEADLINE
  DEEP_WORK_SHIFT
  OTHER
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// The kinds of work a subject can contain. They differ in how the planner
/// spreads them: exam revision is spaced evenly up to the day before, while
/// assignments and projects are front-loaded to leave a buffer.
enum ItemType {
  TASK
  ASSIGNMENT
  PROJECT
  EXAM
}

enum ItemStatus {
  TODO
  DONE
}

/// A recurring commitment: a course, a client, or a standing block of focus time.
/// Seeded defaults are ordinary rows, so the user has full CRUD over them from
/// the moment the account exists.
model Subject {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  category Category
  /// Course code, client code, or project key. e.g. "CS 4780", "ACME-2"
  code     String?
  /// Hex, for the calendar. Stored per subject so palettes survive a redesign.
  colorHex String   @default("#4C6EF5")
  notes    String?

  /// 1-10 difficulty rating, feeds the smart scheduling priority score.
  difficulty Int       @default(5)
  /// Optional exam or deadline date. When set, the scheduling engine weights
  /// this subject more heavily as the date approaches.
  examDate   DateTime?

  /// Stable identity of a starter template, e.g. "core-lecture". Null for rows
  /// the user created themselves.
  ///
  /// Identity has to be a key rather than the name. "Restore defaults" skips
  /// templates the user still has, and matching on name means a renamed template
  /// is treated as missing and silently re-created alongside the rename. A key
  /// survives renaming, so restore only ever fills genuine gaps.
  ///
  /// Purely informational otherwise: nothing branches on it, so seeded rows are
  /// edited and deleted through the same paths as any other row.
  seedKey String?

  /// Soft delete. Archiving keeps historical events readable; a hard delete
  /// detaches them via onDelete: SetNull below.
  archivedAt DateTime?

  events ScheduleEvent[]
  items  SubjectItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ownership as part of the unique selector. See the note at the top.
  @@unique([id, userId])
  // One name per user, not globally.
  @@unique([userId, name])
  // One copy of each starter template per user. Postgres treats NULLs as
  // distinct in a unique index, so user-created rows are unaffected.
  @@unique([userId, seedKey])
  @@index([userId, archivedAt])
}

/// A piece of work inside a subject: an assignment, an exam to revise for, a
/// project or a plain task. Subjects are the containers; these are what the
/// smart scheduler actually plans.
model SubjectItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String
  /// Related through (subjectId, userId) against Subject's compound unique, so
  /// the database itself refuses an item whose subject belongs to someone else.
  /// No application check can be forgotten when the constraint is the check.
  subject   Subject @relation(fields: [subjectId, userId], references: [id, userId], onDelete: Cascade)

  title  String
  type   ItemType   @default(TASK)
  status ItemStatus @default(TODO)

  /// Due date, or the exam date for EXAM. Date-only, stored at UTC midnight.
  dueDate          DateTime?
  /// Total effort the work needs. Null means "suggest one", which the planner
  /// derives from the type and the subject's difficulty.
  estimatedMinutes Int?
  /// 1 low, 2 normal, 3 high. Breaks ties between items due on the same day.
  priority         Int       @default(2)
  notes            String?

  events ScheduleEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, userId])
  @@index([userId, subjectId])
  @@index([userId, status, dueDate])
}

/// A single dated commitment on the calendar.
model ScheduleEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Optional: an ad-hoc event need not belong to a subject. Deleting a subject
  /// detaches its events rather than destroying the history.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  /// The sub-item this block works on, when the planner scheduled one.
  ///
  /// A single-column relation rather than (itemId, userId): SetNull on a
  /// compound key would try to null userId too. Ownership is checked in the
  /// data layer instead, the same way subjectId is. Deleting an item detaches
  /// finished blocks and the data layer removes its unfinished ones.
  itemId String?
  item   SubjectItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  title    String
  /// Denormalised from Subject so ad-hoc events are categorised too, and so a
  /// calendar query does not need the join.
  category Category

  startsAt DateTime
  endsAt   DateTime
  /// All-day items such as a deadline, where the time component is meaningless.
  isAllDay Boolean  @default(false)

  location String?
  notes    String?
  status   EventStatus @default(SCHEDULED)

  /// RFC 5545 RRULE for repeats, e.g. "FREQ=WEEKLY;BYDAY=TU,TH".
  /// Occurrences are expanded at read time rather than stored as rows.
  recurrenceRule String?

  /// When the smart scheduler created this row. Null for anything the user
  /// entered by hand.
  ///
  /// A timestamp rather than a boolean because one press of "Generate" is one
  /// batch: every block in a run shares an instant, so "undo the last plan" is
  /// a delete by that value, and "replace the plan in this range" does not have
  /// to guess which blocks were machine-made. Editing a generated block leaves
  /// the stamp alone; the user can detach it by clearing the plan and keeping
  /// the row, which the UI does not need yet.
  generatedAt DateTime?

  /// One sentence from the planner on why the block sits where it does, shown
  /// when hovering it. Null for hand-made events, and cleared when the block is
  /// moved to another time, because the reason described the old slot.
  planReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, userId])
  // Serves the dominant query: this user's events in a date window.
  @@index([userId, startsAt])
  @@index([userId, subjectId])
  @@index([userId, itemId])
  // Serves "the blocks the scheduler made in this window", which every
  // regenerate and every clear has to answer before it writes.
  @@index([userId, generatedAt])
}

// ---------------------------------------------------------------------------
// Rate limiting
// ---------------------------------------------------------------------------

/// One fixed-window counter per key. The key is `<policy>:<subject>`, where the
/// subject is a user id or a SHA-256 of an IP address or email, so no address
/// is stored in the clear.
///
/// Counters live in Postgres rather than in process memory because the app runs
/// on serverless functions: every instance has its own memory, so an in-memory
/// limit would multiply by however many instances happen to be warm.
model RateLimitBucket {
  key     String   @id
  count   Int
  /// timestamptz, so comparisons against now() mean the same instant whatever
  /// the database session's timezone is.
  resetAt DateTime @db.Timestamptz(3)

  // Serves the periodic sweep of expired windows.
  @@index([resetAt])
}
